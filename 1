<!doctype html>
<html lang="el">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Quiz Master — Άπειρες Ερωτήσεις</title>
<style>
:root{--bg:#0b1020;--card:#151c33;--card2:#1c2542;--text:#f5f7ff;--muted:#aab4d0;--accent:#7c5cff;--good:#25c98a;--bad:#ff5c75}
*{box-sizing:border-box} body{margin:0;background:radial-gradient(circle at top,#202b55,#0b1020 55%);color:var(--text);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh}
.wrap{max-width:920px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}
.logo{font-weight:900;font-size:25px}.logo span{color:#9b86ff}.stats{display:flex;gap:8px;flex-wrap:wrap}.pill{background:#121a31;border:1px solid #2b3658;padding:8px 12px;border-radius:999px;font-weight:700;font-size:13px}
.card{background:rgba(21,28,51,.96);border:1px solid #2b3658;border-radius:24px;padding:24px;box-shadow:0 18px 50px #0006}
.start{text-align:center;padding:48px 24px}.start h1{font-size:44px;margin:0 0 10px}.start p{color:var(--muted);font-size:17px;max-width:650px;margin:0 auto 28px}
.controls{display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:620px;margin:20px auto}
select,button{font:inherit}.select{background:#11182e;color:white;border:1px solid #344064;border-radius:14px;padding:13px;text-align:left}
button{border:0;border-radius:14px;padding:14px 18px;font-weight:800;cursor:pointer;transition:.15s; color:white;background:var(--accent)}
button:hover{transform:translateY(-1px);filter:brightness(1.08)}button.secondary{background:#252f4f}.full{grid-column:1/-1}
.meta{display:flex;justify-content:space-between;color:var(--muted);font-size:14px;margin-bottom:20px}.timer{color:#fff;font-weight:900}
.question{font-size:27px;line-height:1.25;font-weight:850;margin:10px 0 24px}
.answers{display:grid;grid-template-columns:1fr 1fr;gap:12px}.answer{background:var(--card2);border:1px solid #344064;text-align:left;min-height:62px}.answer.correct{background:#123f35;border-color:var(--good)}.answer.wrong{background:#4a1e2b;border-color:var(--bad)}.answer:disabled{cursor:default;transform:none}
.feedback{min-height:28px;margin-top:17px;font-weight:800}.good{color:var(--good)}.bad{color:var(--bad)}
.next{margin-top:14px;width:100%}.hidden{display:none!important}
.progress{height:7px;background:#0e1427;border-radius:99px;overflow:hidden;margin-bottom:22px}.bar{height:100%;background:linear-gradient(90deg,#7c5cff,#b48cff);width:0;transition:.3s}
.results{text-align:center;padding:42px 20px}.score{font-size:64px;font-weight:950;margin:10px}.small{color:var(--muted)}
@media(max-width:650px){.wrap{padding:12px}.card{padding:18px}.start h1{font-size:34px}.answers,.controls{grid-template-columns:1fr}.question{font-size:23px}.stats{justify-content:flex-end}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div class="logo">QUIZ <span>MASTER</span></div>
    <div class="stats">
      <div class="pill">🏆 <span id="score">0</span></div>
      <div class="pill">🔥 <span id="streak">0</span></div>
      <div class="pill">❓ <span id="count">0</span></div>
    </div>
  </div>

  <div id="start" class="card start">
    <h1>Έτοιμος για το Quiz; 🧠</h1>
    <p>Άπειρες αναμετρήσεις, πολλές κατηγορίες, τυχαίες ερωτήσεις και σύστημα σκορ/streak. Κάθε παρτίδα είναι διαφορετική.</p>
    <div class="controls">
      <select id="category" class="select">
        <option value="all">🌍 Όλες οι κατηγορίες</option>
        <option value="science">🔬 Επιστήμη</option><option value="history">🏛️ Ιστορία</option>
        <option value="geography">🌍 Γεωγραφία</option><option value="space">🚀 Διάστημα</option>
        <option value="sports">⚽ Αθλητισμός</option><option value="technology">💻 Τεχνολογία</option>
        <option value="cinema">🎬 Κινηματογράφος</option><option value="music">🎵 Μουσική</option>
        <option value="animals">🐾 Ζώα</option><option value="food">🍕 Φαγητό</option>
        <option value="mythology">⚡ Μυθολογία</option><option value="literature">📚 Λογοτεχνία</option>
        <option value="math">➗ Μαθηματικά</option><option value="language">🔤 Γλώσσα</option>
        <option value="general">🧠 Γενικές γνώσεις</option>
      </select>
      <select id="difficulty" class="select">
        <option value="mixed">🎲 Μικτή δυσκολία</option><option value="easy">🟢 Εύκολο</option>
        <option value="medium">🟡 Μέτριο</option><option value="hard">🔴 Δύσκολο</option>
      </select>
      <button id="startBtn" class="full" type="button">ΞΕΚΙΝΑΜΕ 🚀</button>
    </div>
    <div class="small">Στόχος: όσο μεγαλύτερο streak, τόσο περισσότερους πόντους.</div>
  </div>

  <div id="game" class="card hidden">
    <div class="progress"><div id="bar" class="bar"></div></div>
    <div class="meta"><span id="cat"></span><span>Χρόνος: <b class="timer" id="timer">20</b>s</span></div>
    <div id="question" class="question"></div>
    <div id="answers" class="answers"></div>
    <div id="feedback" class="feedback"></div>
    <button id="next" class="next hidden" onclick="nextQuestion()">ΕΠΟΜΕΝΗ ➜</button>
  </div>

  <div id="results" class="card results hidden">
    <div style="font-size:48px">🏆</div><h2>Τέλος παρτίδας!</h2>
    <div class="score" id="finalScore">0</div>
    <div id="finalText" class="small"></div>
    <button style="margin-top:22px" onclick="startGame()">ΠΑΙΞΕ ΞΑΝΑ 🔄</button>
    <button class="secondary" style="margin-top:10px" onclick="showStart()">ΑΛΛΑΓΗ ΡΥΘΜΙΣΕΩΝ</button>
  </div>
</div>

<script>
const QUESTIONS = [
