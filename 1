["sports","easy","Πόσους πόντους αξίζει ένα τρίποντο στο μπάσκετ;","3","2","4","1"],
["sports","medium","Ποιο Grand Slam διεξάγεται στο χώμα;","Roland Garros","Wimbledon","US Open","Australian Open"],
["sports","medium","Πόσα λεπτά διαρκεί κανονικά ένας αγώνας ποδοσφαίρου;","90","80","100","60"],
["sports","hard","Ποια χώρα έχει κατακτήσει τα περισσότερα Παγκόσμια Κύπελλα ποδοσφαίρου ανδρών;","Βραζιλία","Γερμανία","Ιταλία","Αργεντινή"],
["technology","easy","Τι σημαίνουν τα αρχικά CPU;","Central Processing Unit","Computer Personal Unit","Core Program Utility","Central Program User"],
["technology","easy","Τι είναι ένα SSD;","Μονάδα αποθήκευσης στερεάς κατάστασης","Κάρτα γραφικών","Τύπος επεξεργαστή","Πρωτόκολλο δικτύου"],
["technology","medium","Ποια γλώσσα χρησιμοποιείται ευρέως για διαδραστικότητα σε ιστοσελίδες;","JavaScript","SQL","Bash","R"],
["technology","hard","Τι σημαίνει DNS;","Domain Name System","Digital Network Security","Data Node Service","Domain Number Server"],
["cinema","easy","Ποιος σκηνοθέτησε την ταινία Titanic (1997);","James Cameron","Steven Spielberg","Christopher Nolan","Ridley Scott"],
["cinema","easy","Ποιος έπαιξε τον Jack Sparrow;","Johnny Depp","Brad Pitt","Tom Cruise","Hugh Jackman"],
["cinema","medium","Ποια ταινία κέρδισε Όσκαρ Καλύτερης Ταινίας το 1994;","Forrest Gump","Pulp Fiction","The Shawshank Redemption","Speed"],
["cinema","hard","Ποια ταινία του Christopher Nolan πραγματεύεται όνειρα μέσα σε όνειρα;","Inception","Tenet","Memento","Dunkirk"],
["music","easy","Πόσες χορδές έχει συνήθως μια κλασική κιθάρα;","6","4","5","7"],
["music","easy","Ποιο συγκρότημα κυκλοφόρησε το The Dark Side of the Moon;","Pink Floyd","Queen","The Beatles","Nirvana"],
["music","medium","Ποιος καλλιτέχνης είναι γνωστός ως «King of Pop»;","Michael Jackson","Elvis Presley","Prince","David Bowie"],
["music","hard","Ποιος συνέθεσε την 9η Συμφωνία;","Ludwig van Beethoven","Mozart","Bach","Chopin"],
["animals","easy","Ποιο είναι το μεγαλύτερο ζώο που έχει ζήσει στη Γη;","Γαλάζια φάλαινα","Ελέφαντας","Καμηλοπάρδαλη","Λευκός καρχαρίας"],
["animals","easy","Ποιο είναι το ταχύτερο χερσαίο ζώο;","Τσίτα","Λιοντάρι","Άλογο","Αντιλόπη"],
["animals","medium","Ποιο θηλαστικό μπορεί να πετάξει πραγματικά;","Νυχτερίδα","Ιπτάμενος σκίουρος","Λεμούριος","Κολίβριο"],
["animals","hard","Πόσες καρδιές έχει ένα χταπόδι;","3","1","2","4"],
["food","easy","Από ποια χώρα προέρχεται παραδοσιακά η πίτσα Margherita;","Ιταλία","Ισπανία","Γαλλία","Ελλάδα"],
["food","easy","Ποιο συστατικό είναι βασικό στο χούμους;","Ρεβίθια","Φακές","Πατάτα","Ρύζι"],
["food","medium","Ποια χώρα συνδέεται περισσότερο με το sushi;","Ιαπωνία","Κορέα","Κίνα","Ταϊλάνδη"],
["food","hard","Ποιο μπαχαρικό προέρχεται από το Crocus sativus;","Κρόκος (σαφράν)","Κανέλα","Κάρδαμο","Κύμινο"],
["mythology","easy","Ποιος ήταν ο θεός του κεραυνού στην αρχαία ελληνική μυθολογία;","Δίας","Άρης","Απόλλων","Ήφαιστος"],
["mythology","easy","Ποια θεά συνδέεται με τη σοφία και την Αθήνα;","Αθηνά","Άρτεμις","Ήρα","Δήμητρα"],
["mythology","medium","Ποιος σκότωσε τον Μινώταυρο;","Θησέας","Ηρακλής","Περσέας","Ιάσονας"],
["mythology","hard","Ποιο ήταν το όνομα του σκύλου του Οδυσσέα;","Άργος","Κέρβερος","Λαίλαπας","Άτλας"],
["literature","easy","Ποιος έγραψε τον Δον Κιχώτη;","Μιγκέλ ντε Θερβάντες","Ντάντε","Σαίξπηρ","Ουγκό"],
["literature","easy","Ποιος έγραψε τον Άρχοντα των Δαχτυλιδιών;","J. R. R. Tolkien","C. S. Lewis","George R. R. Martin","J. K. Rowling"],
["literature","medium","Ποιος έγραψε την Οδύσσεια;","Όμηρος","Ηρόδοτος","Σοφοκλής","Αριστοτέλης"],
["literature","hard","Ποιος Έλληνας ποιητής τιμήθηκε με Νόμπελ Λογοτεχνίας το 1979;","Οδυσσέας Ελύτης","Γιώργος Σεφέρης","Κωνσταντίνος Καβάφης","Γιάννης Ρίτσος"],
["math","easy","Πόσο κάνει 12 × 8;","96","86","108","92"],
["math","easy","Ποια είναι η τετραγωνική ρίζα του 144;","12","14","10","16"],
["math","medium","Πόσο είναι το 15% του 200;","30","20","25","35"],
["math","medium","Ποιο είναι το άθροισμα των γωνιών ενός τριγώνου;","180°","90°","270°","360°"],
["math","hard","Ποιος είναι ο αριθμός e περίπου;","2,718","3,142","1,618","2,414"],
["language","easy","Ποια λέξη είναι συνώνυμη του «γρήγορος»;","ταχύς","βαρύς","ήρεμος","μικρός"],
["language","easy","Ποιο είναι το αντίθετο του «σπάνιος»;","συχνός","μικρός","ήσυχος","αργός"],
["language","medium","Ποια από τις παρακάτω λέξεις είναι επίρρημα;","γρήγορα","δρόμος","όμορφος","τρέχω"],
["general","easy","Πόσες ημέρες έχει ένα δίσεκτο έτος;","366","365","364","367"],
["general","easy","Ποιο χρώμα προκύπτει από μπλε και κίτρινο;","Πράσινο","Μωβ","Πορτοκαλί","Ροζ"],
["general","medium","Πόσες πλευρές έχει ένα εξάγωνο;","6","5","7","8"],
["general","hard","Ποια χώρα έχει πρωτεύουσα την Ουλάν Μπατόρ;","Μογγολία","Καζακστάν","Νεπάλ","Μπουτάν"]
];

const NAMES={science:"🔬 Επιστήμη",history:"🏛️ Ιστορία",geography:"🌍 Γεωγραφία",space:"🚀 Διάστημα",sports:"⚽ Αθλητισμός",technology:"💻 Τεχνολογία",cinema:"🎬 Κινηματογράφος",music:"🎵 Μουσική",animals:"🐾 Ζώα",food:"🍕 Φαγητό",mythology:"⚡ Μυθολογία",literature:"📚 Λογοτεχνία",math:"➗ Μαθηματικά",language:"🔤 Γλώσσα",general:"🧠 Γενικές γνώσεις"};
const DIFF={easy:"Εύκολο",medium:"Μέτριο",hard:"Δύσκολο"};
const $=id=>document.getElementById(id);
let game={score:0,streak:0,count:0,used:new Set(),timer:null,time:20,current:null};

function startGame(){
  clearInterval(game.timer);
  game={score:0,streak:0,count:0,used:new Set(),timer:null,time:20,current:null};
  $("start").classList.add("hidden"); $("results").classList.add("hidden"); $("game").classList.remove("hidden");
  updateStats(); nextQuestion();
}
function showStart(){
  clearInterval(game.timer);
  $("game").classList.add("hidden"); $("results").classList.add("hidden"); $("start").classList.remove("hidden");
}
function updateStats(){
  $("score").textContent=game.score; $("streak").textContent=game.streak; $("count").textContent=game.count;
  $("bar").style.width=((game.count%10)*10)+"%";
}
function chooseQuestion(){
  const cat=$("category").value, diff=$("difficulty").value;
  let pool=QUESTIONS.map((q,i)=>({q,i})).filter(x=>(cat==="all"||x.q[0]===cat)&&(diff==="mixed"||x.q[1]===diff)&&!game.used.has(x.i));
  if(pool.length===0){game.used.clear(); pool=QUESTIONS.map((q,i)=>({q,i})).filter(x=>(cat==="all"||x.q[0]===cat)&&(diff==="mixed"||x.q[1]===diff));}
  const picked=pool[Math.floor(Math.random()*pool.length)]; game.used.add(picked.i); return picked.q;
}
function nextQuestion(){
  clearInterval(game.timer);
  game.current=chooseQuestion(); game.count++; updateStats();
  const q=game.current;
  $("cat").textContent=NAMES[q[0]]+" • "+DIFF[q[1]];
  $("question").textContent=q[2]; $("feedback").textContent=""; $("feedback").className="feedback";
  $("next").classList.add("hidden");
  const opts=q.slice(3).sort(()=>Math.random()-0.5), box=$("answers"); box.innerHTML="";
  opts.forEach(opt=>{
    const b=document.createElement("button"); b.className="answer"; b.textContent=opt;
    b.addEventListener("click",()=>answer(b,opt,q[3])); box.appendChild(b);
  });
  game.time=20; $("timer").textContent=20;
  game.timer=setInterval(()=>{
    game.time--; $("timer").textContent=game.time;
    if(game.time<=0){clearInterval(game.timer); finishQuestion(null,q[3],false);}
  },1000);
}
function answer(btn,chosen,correct){
  clearInterval(game.timer); finishQuestion(btn,correct,chosen===correct);
}
function finishQuestion(btn,correct,isCorrect){
  document.querySelectorAll(".answer").forEach(b=>{b.disabled=true;if(b.textContent===correct)b.classList.add("correct");});
  if(isCorrect){
    if(btn) btn.classList.add("correct");
    game.streak++;
    const points=100+(game.streak-1)*25+game.time*5; game.score+=points;
    $("feedback").textContent=`Σωστό! +${points} πόντοι 🔥`; $("feedback").className="feedback good";
  }else{
    if(btn) btn.classList.add("wrong");
    game.streak=0;
    $("feedback").textContent=`Λάθος! Η σωστή απάντηση είναι: ${correct}`; $("feedback").className="feedback bad";
  }
  updateStats(); $("next").classList.remove("hidden");
}

document.addEventListener("DOMContentLoaded", function(){
  const btn=document.getElementById("startBtn");
  if(btn) btn.addEventListener("click", function(e){
    e.preventDefault();
    try { startGame(); } catch(err) {
      console.error(err);
      alert("Έγινε σφάλμα στην εκκίνηση του παιχνιδιού. Δοκίμασε ξανά.");
    }
  });
});
</script>
</body>
</html>
